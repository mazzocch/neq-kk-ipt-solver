{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "N_points": {
            "type": "integer",
            "description": "Number of points in frequency domain."
        },
        "w_max": {
            "type": "number",
            "description": "Maximum value of frequency."
        },
        "U": {
            "type": "number",
            "description": "Value of the Hubbard interaction."
        },
        "flavors": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Contains the flavors. So far only implemented for 'up' and 'down'."
        },
        "strict": {
            "type": "boolean",
            "description": "Raises an error if a json validation fails. Default is 'False'."
        }
    },
    "additionalProperties": false,
    "required": [
        "N_points",
        "w_max",
        "U",
        "flavors"
    ]
}